---
interface Props {
  /** Each string is one rendered line — SVG text does not wrap on its own. */
  lines: string[];
  /** Font size in user units; drop it if a line runs long. */
  size?: number;
}

const { lines, size = 32 } = Astro.props;

const padX = 44;
const padY = 40;
const lead = size * 1.42;
const boxW = 560;
const boxH = Math.round(padY * 2 + lead * lines.length - lead * 0.28);
const width = boxW + 48;
const height = boxH + 44;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${width} ${height}`}
  class="cursor-select h-auto w-full"
  style={`--box-w:${boxW}px;--box-h:${boxH}px;--vb-w:${width}px;--vb-h:${height}px`}
  role="img"
  aria-label={lines.join(" ")}
>
  <!-- Selection rectangle + its corner handles, revealed on the "click" -->
  <g class="cs-box">
    <rect
      x="24"
      y="24"
      width={boxW}
      height={boxH}
      fill="var(--accent-live)"
      fill-opacity="0.06"
      stroke="var(--accent-live)"
      stroke-width="2"
    />
    {[
      [24, 24],
      [24 + boxW, 24],
      [24, 24 + boxH],
      [24 + boxW, 24 + boxH],
    ].map(([hx, hy]) => (
      <rect
        x={hx - 5}
        y={hy - 5}
        width="10"
        height="10"
        fill="var(--surface)"
        stroke="var(--accent-live)"
        stroke-width="2"
      />
    ))}
  </g>

  <text
    class="cs-text"
    x={padX}
    y={24 + padY + size * 0.78}
    fill="currentColor"
    font-size={size}
    font-weight="700"
  >
    {lines.map((line, i) => (
      <tspan x={padX} dy={i === 0 ? 0 : lead}>{line}</tspan>
    ))}
  </text>

  <!-- Pointer -->
  <g class="cs-cursor">
    <path
      d="M0 0 L0 26 L6.4 19.6 L10.6 28.4 L14.8 26.4 L10.6 17.8 L19 17.2 Z"
      fill="var(--accent-live)"
      stroke="var(--surface)"
      stroke-width="1.6"
      stroke-linejoin="round"
    />
  </g>
</svg>

<style>
  .cursor-select {
    overflow: visible;
    font-family: var(--font-display), ui-sans-serif, system-ui, sans-serif;
  }

  .cs-cursor {
    transform-box: view-box;
    transform-origin: 0 0;
    opacity: 0;
    animation: cs-cursor 6s ease-in-out infinite;
  }

  /* Travels in from the right, lands on the copy, clicks, drifts away. */
  @keyframes cs-cursor {
    0% {
      opacity: 0;
      transform: translate(calc(var(--vb-w) + 60px), calc(var(--vb-h) + 40px)) scale(1);
    }
    18% {
      opacity: 1;
      transform: translate(calc(var(--box-w) * 0.72), calc(var(--box-h) * 0.86)) scale(1);
    }
    46% {
      opacity: 1;
      transform: translate(calc(var(--box-w) * 0.38), calc(var(--box-h) * 0.5)) scale(1);
    }
    /* click */
    52% {
      opacity: 1;
      transform: translate(calc(var(--box-w) * 0.38), calc(var(--box-h) * 0.5)) scale(0.86);
    }
    58% {
      opacity: 1;
      transform: translate(calc(var(--box-w) * 0.38), calc(var(--box-h) * 0.5)) scale(1);
    }
    88% {
      opacity: 1;
      transform: translate(calc(var(--box-w) * 0.12), calc(var(--box-h) * 0.16)) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(calc(var(--box-w) * 0.05), calc(var(--box-h) * 0.05)) scale(1);
    }
  }

  .cs-box {
    opacity: 0;
    animation: cs-box 6s ease-in-out infinite;
  }
  @keyframes cs-box {
    0%,
    52% {
      opacity: 0;
    }
    56%,
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-cursor {
      animation: none;
      opacity: 1;
      transform: translate(calc(var(--box-w) * 0.38), calc(var(--box-h) * 0.5));
    }
    .cs-box {
      animation: none;
      opacity: 1;
    }
  }
</style>
