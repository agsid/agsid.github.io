---
import { Image } from "astro:assets";
import logo from "../assets/sidlogo.png";

const { pathname } = Astro.url;
const links = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/projects/", label: "Projects" },
  { href: "/blog/", label: "Journal" },
];
---

<header class="sticky top-0 z-50 px-4 pt-4 sm:px-6" data-site-header>
  <div class="relative mx-auto flex max-w-5xl items-center justify-between gap-4 rounded-2xl border-2 border-black/80 bg-white/50 py-2 pr-2 pl-4 shadow-[4px_4px_0px_#000] backdrop-blur-xl dark:border-white/70 dark:bg-[#1b1b1f]/40 dark:shadow-[4px_4px_0px_rgba(255,255,255,0.25)]">
    <a href="/" class="flex shrink-0 items-center gap-2 font-display text-lg font-extrabold tracking-tight" aria-label="Sid Agrawal home">
      <Image src={logo} alt="" widths={[96, 192]} sizes="48px" class="h-11 w-auto" loading="eager" />
      SID AG

    </a>

    <nav
      aria-label="Primary"
      class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-1 rounded-xl bg-black/5 p-1.5 shadow-[inset_2px_2px_5px_rgba(0,0,0,0.15),inset_-2px_-2px_5px_rgba(255,255,255,0.6)] md:flex dark:bg-white/5 dark:shadow-[inset_2px_2px_5px_rgba(0,0,0,0.4),inset_-2px_-2px_5px_rgba(255,255,255,0.05)]"
    >
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={pathname === link.href ? "page" : undefined}
          class:list={[
            "rounded-lg px-4 py-1.5 text-xs font-semibold tracking-wide uppercase transition-all",
            pathname === link.href
              ? "border-2 border-black bg-white text-black shadow-[2px_2px_0px_#000] dark:border-white dark:bg-[#1b1b1f] dark:text-white dark:shadow-[2px_2px_0px_#fff]"
              : "border-2 border-transparent text-black/50 hover:text-black dark:text-white/50 dark:hover:text-white",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-black/80 bg-white/40 shadow-[2px_2px_0px_#000] backdrop-blur dark:border-white/70 dark:bg-black/20 dark:shadow-[2px_2px_0px_rgba(255,255,255,0.4)]"
      >
        <svg class="dark:hidden" viewBox="0 0 24 24" fill="none" width="16" height="16"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        <svg class="hidden dark:block" viewBox="0 0 24 24" fill="none" width="16" height="16"><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4l1.4-1.4M18 6l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>

      <a
        href="/contact/"
        class="group hidden items-center gap-3 rounded-full border-2 border-black bg-[#17171a] py-1.5 pr-1.5 pl-4 text-sm font-semibold text-white shadow-[3px_3px_0px_#000] md:flex dark:border-white dark:bg-black/40 dark:shadow-[3px_3px_0px_rgba(255,255,255,0.3)]"
      >
        Contact
        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-lime-300 text-[#17171a] transition-transform group-hover:translate-x-0.5">
          →
        </span>
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="flex h-9 w-9 flex-col items-center justify-center gap-[5px] rounded-full border-2 border-black/80 bg-white/40 shadow-[2px_2px_0px_#000] md:hidden dark:border-white/70 dark:bg-black/20 dark:shadow-[2px_2px_0px_rgba(255,255,255,0.4)]"
      >
        <span class="block h-[2px] w-4 bg-current transition-transform"></span>
        <span class="block h-[2px] w-4 bg-current transition-transform"></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    aria-hidden="true"
    class="mx-auto mt-3 hidden max-w-5xl rounded-2xl border-2 border-black/80 bg-white/70 p-3 shadow-[4px_4px_0px_#000] backdrop-blur-xl md:!hidden dark:border-white/70 dark:bg-[#1b1b1f]/70 dark:shadow-[4px_4px_0px_rgba(255,255,255,0.25)]"
  >
    <nav aria-label="Mobile" class="flex flex-col">
      {links.map((link, i) => (
        <a
          href={link.href}
          aria-current={pathname === link.href ? "page" : undefined}
          class:list={[
            "flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-semibold",
            pathname === link.href ? "bg-black/5 dark:bg-white/10" : "",
          ]}
        >
          <small class="font-display text-[0.65rem] font-bold tracking-widest text-black/35 dark:text-white/35">
            {String(i + 1).padStart(2, "0")}
          </small>
          <span>{link.label}</span>
          <i class="ml-auto text-black/30 not-italic dark:text-white/30">↗</i>
        </a>
      ))}
      <a
        href="/contact/"
        class="mt-2 flex items-center justify-between rounded-xl border-2 border-black bg-[#17171a] px-4 py-3 text-sm font-semibold text-white shadow-[3px_3px_0px_#000] dark:border-white dark:bg-black/40 dark:shadow-[3px_3px_0px_rgba(255,255,255,0.3)]"
      >
        Contact
        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-lime-300 text-[#17171a]">→</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;

  const themeToggle = document.getElementById("theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch (e) {}
  });

  const menuToggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  menuToggle?.addEventListener("click", () => {
    const open = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!open));
    menuToggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    menu?.setAttribute("aria-hidden", String(open));
    menu?.classList.toggle("hidden", open);
  });
</script>
