---
const { pathname } = Astro.url;
const links = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/projects/", label: "Projects" },
  { href: "/blog/", label: "Journal" },
];
---

<header class="sticky top-0 z-50 px-4 pt-4 sm:px-6">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 rounded-2xl border-2 border-black/80 bg-white/50 py-2 pl-4 pr-2 shadow-[4px_4px_0px_#000] backdrop-blur-xl dark:border-white/70 dark:bg-[#1b1b1f]/40 dark:shadow-[4px_4px_0px_rgba(255,255,255,0.25)]">
    <a href="/" class="flex items-center gap-1.5 font-display text-lg font-extrabold tracking-tight">
      Sid
      <span class="rounded-md bg-[#17171a] px-1.5 py-0.5 text-xs font-bold text-white dark:bg-white dark:text-[#17171a]">.io</span>
    </a>

    <nav class="hidden items-center gap-1 rounded-xl bg-black/5 p-1.5 shadow-[inset_2px_2px_5px_rgba(0,0,0,0.15),inset_-2px_-2px_5px_rgba(255,255,255,0.6)] sm:flex dark:bg-white/5 dark:shadow-[inset_2px_2px_5px_rgba(0,0,0,0.4),inset_-2px_-2px_5px_rgba(255,255,255,0.05)]">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "rounded-lg px-4 py-1.5 text-xs font-semibold tracking-wide uppercase transition-all",
            pathname === link.href
              ? "border-2 border-black bg-white text-black shadow-[2px_2px_0px_#000] dark:border-white dark:bg-[#1b1b1f] dark:text-white dark:shadow-[2px_2px_0px_#fff]"
              : "border-2 border-transparent text-black/50 hover:text-black dark:text-white/50 dark:hover:text-white",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-black/80 bg-white/40 shadow-[2px_2px_0px_#000] backdrop-blur dark:border-white/70 dark:bg-black/20 dark:shadow-[2px_2px_0px_rgba(255,255,255,0.4)]"
      >
        <svg class="dark:hidden" viewBox="0 0 24 24" fill="none" width="16" height="16"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        <svg class="hidden dark:block" viewBox="0 0 24 24" fill="none" width="16" height="16"><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4l1.4-1.4M18 6l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <a
        href="/contact/"
        class="group flex items-center gap-3 rounded-full border-2 border-black bg-[#17171a] py-1.5 pl-4 pr-1.5 text-sm font-semibold text-white shadow-[3px_3px_0px_#000] dark:border-white dark:bg-black/40 dark:shadow-[3px_3px_0px_rgba(255,255,255,0.3)]"
      >
        Contact
        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-lime-300 text-[#17171a] transition-transform group-hover:translate-x-0.5">
          →
        </span>
      </a>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch (e) {}
  });
</script>
