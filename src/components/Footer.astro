---
import { Image } from "astro:assets";
import logo from "../assets/sidlogo.png";

const year = new Date().getFullYear();
---

<footer class="px-4 pb-6 sm:px-6">
  <div class="mx-auto max-w-5xl rounded-2xl border-2 border-black/80 bg-white/50 p-8 shadow-[4px_4px_0px_#000] backdrop-blur-xl sm:p-10 dark:border-white/70 dark:bg-[#1b1b1f]/40 dark:shadow-[4px_4px_0px_rgba(255,255,255,0.25)]">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2 font-display text-lg font-extrabold tracking-tight">
          <Image src={logo} alt="" widths={[112, 224]} sizes="56px" class="h-12 w-auto" />
          Sid
          <span class="rounded-md bg-[#17171a] px-1.5 py-0.5 text-xs font-bold text-white dark:bg-white dark:text-[#17171a]">.io</span>
        </a>
        <p class="mt-4 max-w-xs text-sm text-black/60 dark:text-white/60">
          Student developer in Connecticut building robotics team tools, security training platforms, and the occasional
          site that got out of hand.
        </p>
        <p class="mt-5 inline-flex items-center gap-2 rounded-full border-2 border-black/80 bg-white/60 px-3 py-1.5 font-display text-[0.68rem] font-bold tracking-widest uppercase dark:border-white/70 dark:bg-black/20">
          <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
          Open to internships
        </p>
      </div>

      <div>
        <h5 class="font-display text-xs font-bold tracking-widest text-black/40 uppercase dark:text-white/40">Explore</h5>
        <div class="mt-4 flex flex-col gap-2.5 text-sm">
          <a class="w-fit hover:text-[color:var(--color-accent)] dark:hover:text-[color:var(--color-accent-dark)]" href="/projects/">Projects</a>
          <a class="w-fit hover:text-[color:var(--color-accent)] dark:hover:text-[color:var(--color-accent-dark)]" href="/about/">About</a>
          <a class="w-fit hover:text-[color:var(--color-accent)] dark:hover:text-[color:var(--color-accent-dark)]" href="/blog/">Journal</a>
        </div>
      </div>

      <div>
        <h5 class="font-display text-xs font-bold tracking-widest text-black/40 uppercase dark:text-white/40">Get in touch</h5>
        <div class="mt-4 flex flex-col gap-2.5 text-sm">
          <a class="w-fit hover:text-[color:var(--color-accent)] dark:hover:text-[color:var(--color-accent-dark)]" href="mailto:sidagrawal@robotics-catalyst.org">
            sidagrawal@robotics-catalyst.org
          </a>
          <a class="w-fit hover:text-[color:var(--color-accent)] dark:hover:text-[color:var(--color-accent-dark)]" href="/contact/">Contact page</a>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t-2 border-black/10 pt-6 dark:border-white/10">
      <div class="flex gap-2">
        <a
          href="https://github.com/agsid"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-black/80 bg-white/40 shadow-[2px_2px_0px_#000] transition-transform hover:-translate-y-0.5 dark:border-white/70 dark:bg-black/20 dark:shadow-[2px_2px_0px_rgba(255,255,255,0.4)]"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
          </svg>
        </a>
        <a
          href="mailto:sidagrawal@robotics-catalyst.org"
          aria-label="Email"
          class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-black/80 bg-white/40 shadow-[2px_2px_0px_#000] transition-transform hover:-translate-y-0.5 dark:border-white/70 dark:bg-black/20 dark:shadow-[2px_2px_0px_rgba(255,255,255,0.4)]"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
            <path d="M3 6h18v12H3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            <path d="m3 7 9 6 9-6" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      <p class="text-sm text-black/50 dark:text-white/50">&copy; {year} Sid Agrawal</p>
    </div>
  </div>
</footer>
