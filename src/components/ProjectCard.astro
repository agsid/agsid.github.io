---
import { Image } from "astro:assets";

const { project, index = 0 } = Astro.props;
const { title, summary, tags, url, github, color, order, date, image, imageAlt } = project.data;

const num = String(order).padStart(2, "0");
const dateLabel = date
  ? date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
  : null;
// The "PNG bears-website.png" chip. Built from the id and format rather than
// image.src — touching .src makes Astro emit the unoptimised original too.
const filename = image ? `${project.id}.${image.format}` : null;
const ext = image?.format?.toUpperCase() ?? null;

// Pick ink that stays readable on the card's own colour.
const hex = color.replace("#", "");
const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16));
const isDark = (0.299 * r + 0.587 * g + 0.114 * b) / 255 < 0.6;
const ink = isDark ? "#fff" : "#111212";
---

<article
  class="folder-card"
  style={`--card:${color};--ink:${ink};--tabx:${index * 235}px;z-index:${index + 1}`}
>
  <div class="fc-shell">
    <div class="fc-tabrow">
      <div class="fc-tab">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 7h6l2 2h10v9H3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        </svg>
        Project {num}
      </div>
    </div>

    <div class="fc-body">
      <div class="grid items-center gap-8 md:grid-cols-2">
        <div>
          {dateLabel && (
            <p class="fc-meta">
              <span class="fc-dot"></span>
              {dateLabel}
            </p>
          )}
          <h3 class="font-display text-3xl font-bold sm:text-4xl">{title}</h3>
          <p class="mt-4 max-w-sm opacity-85">{summary}</p>
          <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={`/projects/${project.id}/`} class="fc-view">
              Case study
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            {url && (
              <a href={url} target="_blank" rel="noopener" class="fc-view">
                Live site
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 17L17 7M9 7h8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
            {github && (
              <a href={github} target="_blank" rel="noopener" class="fc-view">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48l-.01-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85l-.01 2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
                </svg>
                Source
              </a>
            )}
          </div>
          <div class="mt-6 flex flex-wrap gap-2">
            {tags.map((tag: string) => (
              <span class="fc-tag">{tag}</span>
            ))}
          </div>
        </div>

        <div class="relative">
          {image ? (
            <Image
              src={image}
              alt={imageAlt ?? title}
              widths={[480, 960]}
              sizes="(min-width: 768px) 30rem, 100vw"
              class="fc-frame aspect-[4/3] w-full object-cover"
            />
          ) : (
            <div class="fc-frame flex aspect-[4/3] w-full items-center justify-center bg-black/10 font-display text-7xl font-bold opacity-30">
              {title.charAt(0)}
            </div>
          )}
          {filename && (
            <span class="fc-file">
              {ext && <b>{ext}</b>}
              {filename}
            </span>
          )}
          <span class="fc-handle -top-[5px] -left-[5px]"></span>
          <span class="fc-handle -top-[5px] -right-[5px]"></span>
          <span class="fc-handle -bottom-[5px] -left-[5px]"></span>
          <span class="fc-handle -bottom-[5px] -right-[5px]"></span>
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .folder-card {
    position: relative;
    color: var(--ink);
  }

  /* Cards pile up on one another as you scroll. */
  @media (min-width: 640px) {
    .folder-card {
      position: sticky;
      top: 6.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .folder-card {
      position: relative;
      top: auto;
    }
  }

  /* drop-shadow (not box-shadow) so the offset follows the tab's clip-path. */
  .fc-shell {
    filter: drop-shadow(7px 7px 0 #111212);
  }

  :global([data-theme="dark"]) .fc-shell {
    filter: drop-shadow(7px 7px 0 rgba(242, 241, 238, 0.9));
  }

  .fc-tabrow {
    display: flex;
  }

  .fc-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.6rem 0.5rem 1rem;
    background: var(--card);
    color: var(--ink);
    font-family: var(--font-display), ui-sans-serif, system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 0.6rem 0.6rem 0 0;
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 100%, 0 100%);
  }

  @media (min-width: 640px) {
    .fc-tab {
      transform: translateX(var(--tabx));
    }
  }

  .fc-body {
    background: var(--card);
    border-radius: 0 1rem 1rem 1rem;
    padding: 1.75rem;
  }

  @media (min-width: 640px) {
    .fc-body {
      padding: 2.5rem;
    }
  }

  .fc-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .fc-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: currentColor;
  }

  .fc-view {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.15rem;
    border-bottom: 2px solid currentColor;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .fc-tag {
    padding: 0.35rem 1.1rem 0.35rem 0.7rem;
    background: #fff;
    color: #111212;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    clip-path: polygon(0 0, 100% 0, calc(100% - 11px) 100%, 0 100%);
  }

  .fc-file {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.5rem;
    border-radius: 0.35rem;
    background: #111212;
    color: #fff;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.65rem;
  }

  .fc-file b {
    padding: 0.05rem 0.25rem;
    border-radius: 0.2rem;
    background: var(--card);
    color: #111212;
    font-size: 0.6rem;
  }

  .fc-frame {
    outline: 2px solid rgba(0, 0, 0, 0.35);
    outline-offset: 0;
    border-radius: 0.15rem;
  }

  .fc-handle {
    position: absolute;
    width: 10px;
    height: 10px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.35);
  }
</style>
