---
const { project } = Astro.props;
const { title, summary, tags, url, color, order, date, image } = project.data;
const num = String(order).padStart(2, "0");
const dateLabel = date
  ? date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }).toUpperCase()
  : null;
const filename = image ? image.split("/").pop() : null;
const ext = filename?.includes(".") ? filename.split(".").pop()?.toUpperCase() : null;
---

<div class="relative mt-7">
  <div
    class="absolute -top-7 left-0 z-10 flex items-center gap-1.5 border-2 border-b-0 border-black bg-white px-3 py-1.5 text-xs font-bold tracking-wide text-black uppercase [clip-path:polygon(0_0,100%_0,calc(100%-16px)_100%,0_100%)] dark:border-white dark:bg-[#1b1b1f] dark:text-white"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 6a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    </svg>
    Project {num}
  </div>

  <div
    class="overflow-hidden rounded-2xl border-2 border-black p-6 shadow-[6px_6px_0px_#000] sm:p-10 dark:border-white dark:shadow-[6px_6px_0px_#fff]"
    style={`background-color:${color}`}
  >
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div>
        {dateLabel && (
          <p class="mb-4 flex items-center gap-2 text-xs font-bold tracking-wide text-black/70">
            <span class="h-1.5 w-1.5 rounded-full bg-black"></span>
            {dateLabel}
          </p>
        )}
        <h3 class="font-display text-3xl font-bold text-black sm:text-4xl">{title}</h3>
        <p class="mt-4 max-w-sm text-black/80">{summary}</p>
        <a
          href={url}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center gap-1.5 border-b-2 border-black pb-0.5 text-sm font-bold tracking-wide text-black uppercase"
        >
          View project ↗
        </a>
        <div class="mt-6 flex flex-wrap gap-2">
          {tags.map((tag: string) => (
            <span class="rounded-md border border-black/10 bg-white px-3 py-1 text-xs font-bold tracking-wide text-black uppercase">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <div class="relative">
        {image ? (
          <img src={image} alt={title} class="aspect-[4/3] w-full rounded-xl border-2 border-black object-cover" />
        ) : (
          <div class="flex aspect-[4/3] w-full items-center justify-center rounded-xl border-2 border-black bg-black/10 font-display text-7xl font-bold text-black/30">
            {title.charAt(0)}
          </div>
        )}
        {filename && (
          <span class="absolute top-3 right-3 flex items-center gap-1.5 rounded-md bg-black px-2 py-1 text-[10px] font-bold text-white">
            {ext && <span class="rounded bg-[color:var(--color-accent-dark)] px-1 py-0.5 text-[9px]">{ext}</span>}
            {filename}
          </span>
        )}
        <span class="absolute -top-[5px] -left-[5px] h-[10px] w-[10px] border border-black bg-white"></span>
        <span class="absolute -top-[5px] -right-[5px] h-[10px] w-[10px] border border-black bg-white"></span>
        <span class="absolute -bottom-[5px] -left-[5px] h-[10px] w-[10px] border border-black bg-white"></span>
        <span class="absolute -bottom-[5px] -right-[5px] h-[10px] w-[10px] border border-black bg-white"></span>
      </div>
    </div>
  </div>
</div>
