---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, tags, url, color } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
  <main class="px-6 py-16">
    <div class="mx-auto max-w-2xl">
      <a href="/projects/" class="text-sm font-semibold text-black/50 hover:text-black dark:text-white/50 dark:hover:text-white">
        ← All projects
      </a>

      <div class="mt-4 flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full" style={`background:${color}`}></span>
        <h1 class="font-display text-4xl font-bold">{title}</h1>
      </div>
      <p class="mt-3 text-lg text-black/60 dark:text-white/60">{summary}</p>

      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag: string) => (
          <span class="rounded-full bg-black/5 px-3 py-1 text-xs font-semibold text-black/60 dark:bg-white/10 dark:text-white/60">
            {tag}
          </span>
        ))}
      </div>

      <a
        href={url}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-block rounded-full bg-[color:var(--color-accent)] px-5 py-2.5 text-sm font-semibold text-white"
      >
        Visit live site →
      </a>

      <article class="prose-case mt-10">
        <Content />
      </article>
    </div>
  </main>
</BaseLayout>
