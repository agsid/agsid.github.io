---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

// Entries live in src/content/{volunteering,awards}/*.json — add photos by
// dropping them in src/assets/{volunteering,awards}/ and setting "image".
const volunteering = (await getCollection("volunteering")).sort((a, b) => a.data.order - b.data.order);
const awards = (await getCollection("awards")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Volunteering & Awards"
  description="Volunteer work and awards — robotics mentoring, security workshops, and competition recognition for Sid Agrawal."
>
  <main class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="font-hand text-2xl text-[color:var(--color-accent)] dark:text-[color:var(--color-accent-dark)]">
        beyond the code
      </p>
      <div class="works-intro mt-2">
        <h1 class="works-title">Volunteering <br />&amp; Awards</h1>
        <p class="works-note">
          The work I do for teams and students that isn't a shipped product, and the recognition that came out of it.
        </p>
      </div>

      <!-- Volunteering -->
      <h2 class="mt-16 font-display text-2xl font-bold">Volunteer work</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {volunteering.map((entry) => {
          const { role, org, period, desc, tags, url, image, imageAlt } = entry.data;
          return (
            <article class="entry-card">
              {image && (
                <div class="entry-photo">
                  <Image src={image} alt={imageAlt ?? `${role} at ${org}`} widths={[400, 800]} sizes="(min-width: 640px) 24rem, 100vw" />
                </div>
              )}
              <div class="entry-body">
                <p class="font-display text-[0.65rem] font-bold tracking-widest text-[color:var(--color-accent)] uppercase dark:text-[color:var(--color-accent-dark)]">
                  {period}
                </p>
                <h3 class="mt-2 font-display text-lg font-bold">{role}</h3>
                {url ? (
                  <a href={url} target="_blank" rel="noopener" class="text-sm font-semibold text-black/60 underline-offset-4 hover:underline dark:text-white/60">
                    {org} ↗
                  </a>
                ) : (
                  <p class="text-sm font-semibold text-black/60 dark:text-white/60">{org}</p>
                )}
                <p class="mt-3 text-sm text-black/60 dark:text-white/60">{desc}</p>
                {tags.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {tags.map((tag) => (
                      <span class="rounded-full bg-black/5 px-2.5 py-1 text-xs font-semibold text-black/60 dark:bg-white/10 dark:text-white/60">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <!-- Awards -->
      <h2 class="mt-16 font-display text-2xl font-bold">Awards &amp; recognition</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {awards.map((entry) => {
          const { year, title, org, desc, url, image, imageAlt } = entry.data;
          const Tag = url ? "a" : "div";
          return (
            <Tag
              class="entry-card award-card"
              {...(url ? { href: url, target: "_blank", rel: "noopener" } : {})}
            >
              {image ? (
                <div class="entry-photo">
                  <Image src={image} alt={imageAlt ?? `${title}, ${org}`} widths={[400, 800]} sizes="(min-width: 1024px) 20rem, (min-width: 640px) 24rem, 100vw" />
                  <span class="award-year">{year}</span>
                </div>
              ) : (
                <div class="award-yearblock">{year}</div>
              )}
              <div class="entry-body">
                <h3 class="font-display font-bold">{title}</h3>
                <p class="text-sm font-semibold text-black/50 dark:text-white/50">{org}</p>
                <p class="mt-2 text-sm text-black/60 dark:text-white/60">{desc}</p>
              </div>
            </Tag>
          );
        })}
      </div>

      <div class="mt-16 rounded-2xl border border-black/10 p-6 text-center dark:border-white/10">
        <p class="text-black/60 dark:text-white/60">Want to see what came out of all this?</p>
        <a href="/projects/" class="mt-2 inline-block font-semibold text-[color:var(--color-accent)] dark:text-[color:var(--color-accent-dark)]">
          Browse projects →
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .entry-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid rgba(0, 0, 0, 0.8);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.6);
    box-shadow: 4px 4px 0 #000;
  }

  :global([data-theme="dark"]) .entry-card {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(27, 27, 31, 0.6);
    box-shadow: 4px 4px 0 rgba(255, 255, 255, 0.25);
  }

  .entry-body {
    padding: 1.5rem;
  }

  /* Photos sit flush to the card edge, cropped to a consistent band. */
  .entry-photo {
    position: relative;
    border-bottom: 2px solid rgba(0, 0, 0, 0.8);
  }

  :global([data-theme="dark"]) .entry-photo {
    border-bottom-color: rgba(255, 255, 255, 0.7);
  }

  .entry-photo :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .award-card {
    transition: transform 0.18s ease;
  }

  a.award-card:hover {
    transform: translate(-2px, -2px);
  }

  /* Year badge, over the photo when there is one. */
  .award-year {
    position: absolute;
    bottom: 0.6rem;
    left: 0.6rem;
    padding: 0.25rem 0.6rem;
    border: 2px solid #111212;
    border-radius: 999px;
    background: var(--accent-fill);
    color: #111212;
    font-family: var(--font-display), ui-sans-serif, system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .award-yearblock {
    padding: 0.75rem 1.5rem;
    border-bottom: 2px solid rgba(0, 0, 0, 0.8);
    background: var(--accent-fill);
    color: #111212;
    font-family: var(--font-display), ui-sans-serif, system-ui, sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  :global([data-theme="dark"]) .award-yearblock {
    border-bottom-color: rgba(255, 255, 255, 0.7);
  }

  @media (prefers-reduced-motion: reduce) {
    a.award-card:hover {
      transform: none;
    }
  }
</style>
