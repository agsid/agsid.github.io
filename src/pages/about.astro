---
import BaseLayout from "../layouts/BaseLayout.astro";
import BranchTimeline from "../components/BranchTimeline.astro";
import { Image } from "astro:assets";
import sidCutout from "../assets/sid-top.JPEG";

const focus = [
    {
        title: "Robotics",
        desc: "Design robots in Onshape CAD, 3D print components, and assemble them using a mix of metal and plastic parts. Afterward, I program them using languages like Java and C++.",
    },
    {
        title: "Web",
        desc: "Build websites for teams and organizations to enhance their online presence and drive traffic.",
    },
    {
        title: "Products",
        desc: "Create small, practical products that simplify daily life and make multi-step processes faster.",
    },
];
---

<BaseLayout
    title="About"
    description="About Sid Agrawal — a student developer building robotics software and web platforms in Connecticut."
>
    <main class="px-6 py-16">
        <div class="mx-auto max-w-3xl">
            <span
                class="font-display text-xs font-bold tracking-widest text-[color:var(--color-accent)] uppercase dark:text-[color:var(--color-accent-dark)]"
            >
                About
            </span>
            <h1 class="mt-2 font-display text-4xl font-bold">Hi, I'm Sid.</h1>

            <div
                class="mt-8 flex flex-col gap-6 text-black/70 sm:flex-row sm:items-start dark:text-white/70"
            >
                <Image
                    src={sidCutout}
                    alt="Sid Agrawal"
                    widths={[160, 320]}
                    sizes="160px"
                    class="w-40 shrink-0 rounded-2xl shadow-[0_12px_30px_rgba(0,0,0,0.1)]"
                />
                <div class="space-y-4">
                    <p>
                        I'm a student based in Connecticut with a deep passion
                        for both coding and building. For me, engineering is
                        about bringing ideas to life, whether that's on a screen
                        or in the physical world.
                    </p>
                    <p>
                        On the software side, I code everything from complex
                        Java applications to full-stack websites. I like
                        building practical tools that just work, creating smooth
                        experiences that get out of the user's way.
                    </p>
                    <p>
                        My love for building extends far beyond the keyboard.
                        I've been hands-on for as long as I can remember,
                        growing from snapping together Legos to designing,
                        machining, and constructing custom metal robots for FTC
                        (FIRST Tech Challenge).
                    </p>
                </div>
            </div>

            <h2 class="mt-14 font-display text-2xl font-bold">
                What I work on
            </h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-3">
                {
                    focus.map((f) => (
                        <div class="rounded-2xl border border-black/10 bg-white p-5 dark:border-white/10 dark:bg-[#1b1b1f]">
                            <h3 class="font-display font-bold">{f.title}</h3>
                            <p class="mt-2 text-sm text-black/60 dark:text-white/60">
                                {f.desc}
                            </p>
                        </div>
                    ))
                }
            </div>

            <div class="mt-20 text-center">
                <p class="font-hand text-2xl text-black/50 dark:text-white/50">
                    the story so far
                </p>
                <h2 class="mt-1 font-display text-4xl font-bold">
                    How I got here
                </h2>
            </div>
            <div class="mt-14">
                <BranchTimeline />
            </div>

            <div
                class="mt-14 rounded-2xl border border-black/10 p-6 text-center dark:border-white/10"
            >
                <p class="text-black/60 dark:text-white/60">
                    Want to see what I've actually built?
                </p>
                <a
                    href="/projects/"
                    class="mt-2 inline-block font-semibold text-[color:var(--color-accent)] dark:text-[color:var(--color-accent-dark)]"
                >
                    Browse projects →
                </a>
            </div>
        </div>
    </main>
</BaseLayout>
