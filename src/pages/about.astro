---
import BaseLayout from "../layouts/BaseLayout.astro";
import BranchTimeline from "../components/BranchTimeline.astro";

const focus = [
  { title: "Robotics", desc: "Team ops tools built for robotics teams under the Robotics Catalyst Foundation." },
  { title: "Security / CTF", desc: "Capture-the-flag training platforms and practice environments." },
  { title: "Web", desc: "Static and small-server sites, mostly Svelte and Astro, shipped fast and kept simple." },
];
---

<BaseLayout title="About" description="About Sid Agrawal — a student developer building robotics software, security tools, and web platforms in Connecticut.">
  <main class="px-6 py-16">
    <div class="mx-auto max-w-3xl">
      <span class="font-display text-xs font-bold tracking-widest text-[color:var(--color-accent)] uppercase dark:text-[color:var(--color-accent-dark)]">
        About
      </span>
      <h1 class="mt-2 font-display text-4xl font-bold">Hi, I'm Sid.</h1>

      <div class="mt-8 flex flex-col gap-6 text-black/70 sm:flex-row sm:items-start dark:text-white/70">
        <img src="/images/sid_clear.png" alt="Sid Agrawal" class="w-40 shrink-0 rounded-2xl shadow-[0_12px_30px_rgba(0,0,0,0.1)]" />
        <div class="space-y-4">
          <p>
            I'm a student developer based in Connecticut. Most of my projects come out of the Robotics Catalyst Foundation —
            building the tools robotics teams actually need day to day, rather than what looks good in a portfolio.
          </p>
          <p>
            Outside of robotics, I spend time on security — capture-the-flag challenges and building the platforms that host them —
            and on the web, where I've mostly settled on Svelte and Astro depending on how much interactivity a project actually needs.
          </p>
          <p>
            I like tools that get out of the way. A lot of what I build is for teammates who don't want to think about the software —
            they just want the roster up to date and the scouting sheet to load.
          </p>
        </div>
      </div>

      <h2 class="mt-14 font-display text-2xl font-bold">What I work on</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {focus.map((f) => (
          <div class="rounded-2xl border border-black/10 bg-white p-5 dark:border-white/10 dark:bg-[#1b1b1f]">
            <h3 class="font-display font-bold">{f.title}</h3>
            <p class="mt-2 text-sm text-black/60 dark:text-white/60">{f.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-20 text-center">
        <p class="font-hand text-2xl text-black/50 dark:text-white/50">the story so far</p>
        <h2 class="mt-1 font-display text-4xl font-bold">How I got here</h2>
      </div>
      <div class="mt-14">
        <BranchTimeline />
      </div>

      <div class="mt-14 rounded-2xl border border-black/10 p-6 text-center dark:border-white/10">
        <p class="text-black/60 dark:text-white/60">Want to see what I've actually built?</p>
        <a href="/projects/" class="mt-2 inline-block font-semibold text-[color:var(--color-accent)] dark:text-[color:var(--color-accent-dark)]">
          Browse projects →
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
