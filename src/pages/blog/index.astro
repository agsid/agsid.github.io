---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Journal" description="Notes from Sid Agrawal on robotics, security, and building on the web.">
  <main class="px-6 py-16">
    <div class="mx-auto max-w-2xl">
      <span class="font-display text-xs font-bold tracking-widest text-[color:var(--color-accent)] uppercase dark:text-[color:var(--color-accent-dark)]">
        Journal
      </span>
      <h1 class="mt-2 font-display text-4xl font-bold">Notes</h1>
      <p class="mt-3 text-black/60 dark:text-white/60">Write-ups on what I'm building and why.</p>

      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 sm:auto-rows-[200px]">
        {posts.map((post, i) => (
          <a
            href={`/blog/${post.id}/`}
            class:list={[
              "flex flex-col justify-between rounded-2xl border border-black/10 bg-white p-6 transition-transform hover:-translate-y-1 dark:border-white/10 dark:bg-[#1b1b1f]",
              i === 0 && "sm:col-span-2 sm:row-span-2",
            ]}
          >
            <div>
              <p class="text-xs text-black/40 dark:text-white/40">
                {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </p>
              <h2 class:list={["mt-2 font-display font-bold", i === 0 ? "text-2xl" : "text-xl"]}>{post.data.title}</h2>
              <p class="mt-2 text-sm text-black/60 dark:text-white/60">{post.data.description}</p>
            </div>
            {post.data.tags && (
              <div class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((tag: string) => (
                  <span class="rounded-full bg-black/5 px-2.5 py-1 text-xs font-semibold text-black/60 dark:bg-white/10 dark:text-white/60">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
