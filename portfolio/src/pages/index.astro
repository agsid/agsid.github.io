---
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta
			name="description"
			content="Sid Agrawal — a low-poly touge drive through Japan. Scroll to climb the mountain pass and stop by the projects along the way."
		/>
		<title>Sid Agrawal — Portfolio</title>
	</head>
	<body>
		<div id="planet-mount"><canvas id="planet-canvas"></canvas></div>
		<div class="vignette"></div>
		<nav id="orbit-nav"></nav>

		<main>
			<section id="overview" class="section hero">
				<div class="hero-topbar">
					<div class="brand-pill"><span class="brand-dot"></span>Sid Agrawal</div>
					<a class="badge-pill" href="#stations-track"><span class="badge-dot"></span>Open to internships</a>
				</div>

				<h1 class="hero-headline">Robotics, security &amp;<br />web — built in CT.</h1>

				<div class="hero-side">
					<p class="lede">
						A rising freshman in Connecticut building robotics software, security
						tools, and web platforms. Scroll down to drive the mountain pass and
						pull over at a few of the projects I've shipped.
					</p>
					<a class="scroll-cue" href="#stations-track">
						<span>Start the drive</span>
						<span class="arrow">→</span>
					</a>
				</div>

				<div class="hero-tire hero-tire-left" aria-hidden="true"></div>
				<div class="hero-tire hero-tire-right" aria-hidden="true"></div>
				<div class="hero-name" aria-hidden="true">SID AGRAWAL</div>
				<div class="hero-portrait">
					<img src="/images/sid-cutout.png" alt="Portrait of Sid Agrawal" />
				</div>
				<div class="petal-field" aria-hidden="true"></div>
			</section>

			<div id="stations-track"></div>

			<section id="outro" class="section">
				<h2>Let's build something.</h2>
				<p>
					Always up for talking robotics, security, or whatever weird web
					project comes next.
				</p>
				<div class="outro-links">
					<a class="primary" href="mailto:sidagrawal@robotics-catalyst.org">Email me</a>
					<a href="https://github.com/agsid" target="_blank" rel="noopener">GitHub</a>
				</div>
			</section>
		</main>

		<script src="../scripts/main.js"></script>
	</body>
</html>
